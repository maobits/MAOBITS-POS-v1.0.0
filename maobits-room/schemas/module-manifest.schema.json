{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAOBITS POS Course Module Manifest",
  "type": "object",
  "required": [
    "id",
    "hito",
    "title",
    "kind",
    "version",
    "dependencies",
    "concepts",
    "sourcePaths",
    "assembly",
    "slides",
    "verification",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^hito-[0-9]{2}-"
    },
    "hito": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "kind": {
      "const": "maobits-pos-module"
    },
    "version": {
      "const": "1.0.0"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sourcePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "assembly": {
      "type": "object",
      "required": [
        "inputContracts",
        "outputContracts",
        "rule"
      ]
    },
    "slides": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7
    },
    "verification": {
      "type": "array",
      "minItems": 1
    },
    "status": {
      "type": "string"
    }
  }
}
